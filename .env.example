# Copy to .env and fill in. Never commit .env.
# Secrets only. Model names, URLs and prices live in models.yaml,
# which refers to these keys by name (api_key_env).

SARVAM_API_KEY=
GEMINI_API_KEY=       # research agent (Gemini + Google Search grounding)
# Add one key per provider as needed, e.g.:
# OPENAI_API_KEY=

# --- Storage for runtime data (traces, research cache, saved posts, eval results) ---
# local (default): files in the project folder. gcs: a Google Cloud Storage bucket.
BUILDSOCIAL_STORAGE=local
# BUILDSOCIAL_STORAGE_DIR=.
# BUILDSOCIAL_GCS_BUCKET=buildsocial
# Service account key contents on ONE line (secret; bucket-only access). Or set
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/key.json, or use a gcloud login instead.
# GCS_CREDENTIALS_JSON=

# --- Database ---
# Local: docker compose up -d (uses POSTGRES_PASSWORD). Later on GCP, only DATABASE_URL changes.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+asyncpg://buildsocial:<password>@localhost:5432/buildsocial
