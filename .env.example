# Copy to .env and fill in. Never commit .env.
# Secrets only. Model names, URLs and prices live in models.yaml,
# which refers to these keys by name (api_key_env).

SARVAM_API_KEY=
GEMINI_API_KEY=       # research agent (Gemini + Google Search grounding)
